{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "version": 3,
  "title": "Solar Ember",
  "slug": "schema-solar-ember",
  "blockTypes": [
    "core/group",
    "core/columns"
  ],
  "styles": {
    "color": {
      "background": "var:preset|color|solar-ember",
      "text": "var:preset|color|white"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var:preset|color|white"
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|white",
          "text": "var:preset|color|solar-ember"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|solar-ember-pale",
            "text": "var:preset|color|solar-ember-dark"
          }
        }
      }
    }
  }
}
