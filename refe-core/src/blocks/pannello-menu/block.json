{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "refe/pannello-menu",
  "title": "Pannello menu",
  "category": "refe",
  "icon": "menu-alt",
  "description": "Voce di menu che apre un pannello largo con blocchi a scelta.",
  "parent": [ "core/navigation" ],
  "textdomain": "refe-core",
  "attributes": {
    "label": { "type": "string", "default": "", "role": "content" }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "spacing": { "padding": true, "blockGap": true },
    "color": { "text": true, "background": true, "gradients": true }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css",
  "viewScriptModule": "file:./view.js",
  "render": "file:./render.php"
}
