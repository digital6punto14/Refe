{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "refe/progetti",
  "title": "Case studies",
  "category": "refe",
  "icon": "portfolio",
  "description": "Elenco o carosello dei case studies, con filtri.",
  "textdomain": "refe-core",
  "attributes": {
    "formato": {
      "type": "string",
      "default": "griglia"
    },
    "colonne": {
      "type": "number",
      "default": 2
    },
    "filtri": {
      "type": "boolean",
      "default": false
    },
    "quanti": {
      "type": "number",
      "default": 0
    },
    "scelti": {
      "type": "array",
      "default": []
    },
    "tipo": {
      "type": "number",
      "default": 0
    },
    "soluzione": {
      "type": "number",
      "default": 0
    },
    "escludiCorrente": {
      "type": "boolean",
      "default": false
    },
    "testoTutti": {
      "type": "string",
      "default": "Tutti i progetti"
    },
    "testoLink": {
      "type": "string",
      "default": "Scopri"
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "interactivity": true
  },
  "editorScript": "file:./index.js",
  "style": [
    "refe-comune",
    "file:./style-index.css"
  ],
  "viewScriptModule": "file:./view.js",
  "render": "file:./render.php"
}